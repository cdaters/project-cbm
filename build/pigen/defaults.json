{
  "schema_version": 1,
  "candidate_policy": "private-engineering-poc",
  "account": "pi",
  "uid": 1000,
  "content_root": "/home/pi/pcbm",
  "boot_mode": "menu",
  "default_machine": "x64sc",
  "root": "writable-ext4",
  "expansion_owner": "pcbm-first-boot.service",
  "ssh_enabled": false,
  "samba_enabled": false,
  "tcpser_enabled": false,
  "avahi_enabled": false,
  "networkmanager_enabled": false,
  "baked_password": false,
  "unrestricted_passwordless_sudo": false,
  "passwordless_power_actions": [
    "poweroff",
    "reboot"
  ],
  "console_session": "getty-login-pam",
  "engineering_diagnostic_vt": "tty2",
  "vice_presentation": {
    "initial_aspect_mode": 2,
    "initial_fullscreen": true,
    "initial_fullscreen_mode": 0,
    "user_preferences_preserved": true,
    "initialization": "image-construction-only",
    "pixel_geometry": "VICE per-chip PAL/NTSC"
  }
}
