[Unit]
Description=Optional Project CBM TCP modem bridge
After=network-online.target pcbm-first-boot.service
ConditionPathExists=/etc/pcbm/tcpser.conf

[Service]
Type=simple
User=pi
Group=pi
EnvironmentFile=/etc/pcbm/tcpser.conf
ExecStart=/usr/bin/tcpser $TCPSER_ARGS
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
