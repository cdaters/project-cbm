#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -march=armv8-a -mtune=generic
export DEB_CXXFLAGS_MAINT_APPEND = -march=armv8-a -mtune=generic
%:
	dh $@ --builddirectory=debian/build

override_dh_auto_configure:
	dh_auto_configure -- --enable-sdl2ui --with-alsa --with-sdlsound --without-pulse --disable-arch --enable-x64 --disable-html-docs

override_dh_autoreconf:
	true

override_dh_autoreconf_clean:
	true

override_dh_auto_build:
	dh_auto_build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Wall -Wextra $$(pkg-config --cflags libdrm) debian/drm-state.c -ldrm -o debian/drm-state

override_dh_auto_install:
	dh_auto_install
	install -D -m 0755 debian/drm-state debian/project-cbm-vice/usr/libexec/project-cbm-vice/drm-state

override_dh_auto_clean:
	dh_auto_clean
	rm -f debian/drm-state
