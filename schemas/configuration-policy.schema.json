{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "owner_user",
    "appliance_user",
    "system_ready",
    "network_ready",
    "ready_services"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "owner_user": {
      "const": "pcbm"
    },
    "appliance_user": {
      "const": "pcbm"
    },
    "system_ready": {
      "type": "boolean"
    },
    "network_ready": {
      "type": "boolean"
    },
    "ready_services": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ssh",
          "sharing",
          "modem",
          "discovery"
        ]
      }
    }
  }
}
