{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^x[a-z0-9]+(-80col)?$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "executable": {
            "type": "string",
            "pattern": "^x[a-z0-9]+$",
            "enum": [
              "x64",
              "x64sc",
              "xscpu64",
              "x64dtv",
              "x128",
              "xcbm2",
              "xcbm5x0",
              "xvic",
              "xplus4",
              "xpet"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "video_chips": {
            "type": "array",
            "items": {
              "enum": [
                "VICII",
                "VDC",
                "VIC",
                "TED",
                "CRTC"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "recommended": {
            "type": "boolean"
          },
          "launch_options": {
            "enum": [
              [],
              [
                "-80col"
              ]
            ]
          },
          "cover_asset": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          }
        },
        "required": [
          "id",
          "name",
          "executable",
          "description",
          "video_chips",
          "recommended",
          "launch_options",
          "cover_asset"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "profiles"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-cbm:machine-profiles:1"
}
