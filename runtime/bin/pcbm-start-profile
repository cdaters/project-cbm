#!/usr/bin/env python3
"""One read-only boot preference projection; failure defaults to Menu."""
import sys
from pathlib import Path
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from project_cbm import preferences
from project_cbm.data import registry
try:
    profiles=registry();state=preferences.read(profiles=profiles)
    if state['status']=='ok' and state['values']['boot_preference']=='emulator':
        print(preferences.selection(profiles=profiles,snapshot=state)['id'])
except (OSError,ValueError,TypeError):
    raise SystemExit(2)
