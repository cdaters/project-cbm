[Unit]
Description=Optional Project CBM TCP modem bridge
After=network-online.target pcbm-first-boot.service
ConditionPathExists=/etc/project-cbm/modem.json

[Service]
Type=simple
User=pi
Group=pi
ExecStart=/usr/bin/pcbm-modem
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
